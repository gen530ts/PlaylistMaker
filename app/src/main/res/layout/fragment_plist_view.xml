<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E8EB"
    tools:context=".ui.playlist.PlistViewFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragment_playlist_view_constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidLineStart"
            android:layout_width="@dimen/dim0"
            android:layout_height="@dimen/dim0"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/dim16" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidLineEnd"
            android:layout_width="@dimen/dim0"
            android:layout_height="@dimen/dim0"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/dim16" />


        <ImageView
            android:id="@+id/playlistCoverPlayerImageView"
            android:layout_width="@dimen/dim0"
            android:layout_height="@dimen/dim0"

            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_plist_view"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/backImageView"
            android:src="@drawable/back_arrow_plist_view"
            app:tint="?attr/colorOnPrimary"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dim16"
            android:layout_marginTop="@dimen/dim16"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
 />

        <TextView
            android:id="@+id/playlistNameTextView"
            app:fontFamily="@font/ys_display_regular"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim24"
            app:layout_constraintStart_toStartOf="@id/guidLineStart"
            app:layout_constraintTop_toBottomOf="@id/playlistCoverPlayerImageView"
            tools:text="Best songs ever" />

        <TextView
            android:id="@+id/playlistDescriptionTextView"
            app:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim8"
            app:layout_constraintStart_toStartOf="@id/guidLineStart"
            app:layout_constraintTop_toBottomOf="@id/playlistNameTextView"
            tools:text="2022" />

        <TextView
            android:id="@+id/tracksTimeTextView"
            app:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim8"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/point"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@id/guidLineStart"
            app:layout_constraintTop_toBottomOf="@id/playlistDescriptionTextView"
            tools:text="300 минут" />

        <ImageView
            android:id="@+id/point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dot_plist_view"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/tracksTimeTextView"
            app:layout_constraintEnd_toStartOf="@id/tracksCountTextView"
            app:layout_constraintStart_toEndOf="@id/tracksTimeTextView"
            app:layout_constraintTop_toTopOf="@id/tracksTimeTextView" />

        <TextView
            android:id="@+id/tracksCountTextView"
            app:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/tracksTimeTextView"
            app:layout_constraintEnd_toEndOf="@id/guidLineEnd"
            app:layout_constraintStart_toEndOf="@id/point"
            app:layout_constraintTop_toTopOf="@id/tracksTimeTextView"
            tools:text="98 треков" />

        <ImageView
            android:id="@+id/shareImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dim16"
            android:src="@drawable/share_plist_view"
            app:layout_constraintStart_toEndOf="@id/guidLineStart"
            app:layout_constraintTop_toBottomOf="@id/tracksTimeTextView" />

        <ImageView
            android:id="@+id/moreImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dim16"
            android:layout_marginTop="@dimen/dim16"
            android:src="@drawable/more_plist_view"
            app:layout_constraintStart_toEndOf="@id/shareImageView"
            app:layout_constraintTop_toBottomOf="@id/tracksTimeTextView" />

        <View
            android:id="@+id/supportingViewTrack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dim0"
            android:layout_marginTop="@dimen/dim24"
            android:background="#00000000"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shareImageView" />

        <View
            android:id="@+id/supportingViewMenu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dim0"
            android:background="#00000000"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/playlistDescriptionTextView" />

        <View
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/bottomSheetTracksLinearLayout"
        android:backgroundTint="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottomsheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="200dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dim8"
            android:src="@drawable/bottomsheet_head" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsRecycleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dim24"
            tools:itemCount="5"
            tools:listitem="@layout/search_track" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheetMenuLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottomsheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="383dp"
        android:clickable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dim8"
            android:src="@drawable/bottomsheet_head" />

        <include
            android:id="@+id/pListBlockBSMenu"
            layout="@layout/play_lists_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dim8"
            android:layout_marginTop="@dimen/dim12" />

        <TextView
            android:id="@+id/shareTVBSMenu"
            android:text="@string/share_bs_menu"
            style="@style/plist_view_bsmenu_tv" />

        <TextView
            android:id="@+id/editInfoTVBSMenu"
            style="@style/plist_view_bsmenu_tv"
            android:text="@string/edit_bs_menu" />

        <TextView
            android:id="@+id/deletePListTVBSMenu"
            style="@style/plist_view_bsmenu_tv"
            android:text="@string/delete_bs_menu" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

